# Copy to .env for running the API directly on your machine (without Docker):
# cp .env.example .env
# Every variable is explained in docs/03-configuration.md.

APP_ENV=local
LOG_LEVEL=INFO
ENABLED_MODULES=all
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Local PostgreSQL (docker compose up db -> starts one on localhost:5432)
DB_HOST=localhost
DB_PORT=5432
DB_USER=college
DB_PASSWORD=college
DB_NAME=college

# Fakes so nothing in Google Cloud is needed locally
AUTH_MODE=fake
APP_CHECK_ENABLED=false
REQUIRE_ADMIN_MFA=true
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/storage
PUBLIC_BASE_URL=http://localhost:8000
SHEETS_BACKEND=fake
FAKE_SHEETS_DIR=var/sheets
INTERNAL_AUTH_MODE=token
INTERNAL_TASK_TOKEN=local-internal-token-change-me-0123456789

# Optional: use the real Google Sheet from your machine instead of the fake one
# SHEETS_BACKEND=google
# SHEETS_SPREADSHEET_ID=your-spreadsheet-id
