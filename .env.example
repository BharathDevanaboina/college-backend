# Copy to .env for running the API directly on your machine (without Docker):
# cp .env.example .env
# Every variable is explained in docs/03-configuration.md.

APP_ENV=local
LOG_LEVEL=INFO
ENABLED_MODULES=all
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Web App public configuration (needed by the same-origin /admin UI
# when testing real Firebase Authentication locally; never put service-account
# credentials in this file).
# FIREBASE_WEB_API_KEY=your-public-web-api-key
# FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_WEB_APP_ID=your-web-app-id
# FIREBASE_WEB_MESSAGING_SENDER_ID=your-sender-id
# FIREBASE_WEB_MEASUREMENT_ID=your-measurement-id

# Local PostgreSQL (docker compose up db -> starts one on localhost:5432)
DB_HOST=localhost
DB_PORT=5432
DB_USER=college
DB_PASSWORD=college
DB_NAME=college

# Fakes so nothing in Google Cloud is needed locally
AUTH_MODE=fake
APP_CHECK_ENABLED=false
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/storage
PUBLIC_BASE_URL=http://localhost:8000
SHEETS_BACKEND=fake
FAKE_SHEETS_DIR=var/sheets
INTERNAL_AUTH_MODE=token
INTERNAL_TASK_TOKEN=local-internal-token-change-me-0123456789

# Optional: use the real Google Sheet from your machine instead of the fake one
# SHEETS_BACKEND=google
# SHEETS_SPREADSHEET_ID=your-spreadsheet-id
