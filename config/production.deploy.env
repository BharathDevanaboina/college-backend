# Deployment settings for production, read by scripts/deploy.sh. Not secret.
PROJECT_ID=planetfiance-33123
REGION=asia-south1
SERVICE_NAME=college-api
MIGRATE_JOB_NAME=college-migrate
ARTIFACT_REPOSITORY=college
IMAGE_NAME=college-backend
RUNTIME_SERVICE_ACCOUNT=college-api@planetfiance-33123.iam.gserviceaccount.com
CLOUD_SQL_INSTANCE=planetfiance-33123:asia-south1:college-db
MIN_INSTANCES=1
MAX_INSTANCES=5
CPU=1
MEMORY=512Mi
CONCURRENCY=40
REQUEST_TIMEOUT=300
# ENV_VAR=secret-name:version pairs from Secret Manager
SECRETS=DB_PASSWORD=college-db-password:latest,EXAM_TOKEN_SECRET=college-exam-token-secret:latest
